# Frontend configuration. Copy to .env.local and adjust as needed.
#
# None of these are secrets. The Cognito client ID is public by design -- it
# ships inside the JavaScript bundle and identifies the app, it does not
# authenticate it. Real secrets never belong in a REACT_APP_* variable, because
# every one of them is embedded in the built bundle in plain text.

# 'dev' uses the local identity provider in app/cmd/devidp.
# 'cognito' uses the hosted UI with the authorization-code + PKCE flow.
REACT_APP_AUTH_MODE=dev

# --- dev mode ---
REACT_APP_DEV_IDP_URL=http://localhost:9000

# --- cognito mode ---
# Values come from `terraform output` in infrastructure/environments/dev.
# REACT_APP_COGNITO_DOMAIN=https://<hosted_ui_domain_prefix>.auth.us-east-2.amazoncognito.com
# REACT_APP_COGNITO_CLIENT_ID=<cognito_client_id>
# REACT_APP_REDIRECT_URI=https://<cloudfront_domain>/
